# release 签名密钥（示例文件可入库；真实 .env 不要提交）
# 渠道名在构建时由 -Pchannel=<渠道> 决定，默认 common；
# 变量名 = ANDROID_<渠道大写>_KEY_PATH / STORE_PASSWORD / KEY_ALIAS / KEY_PASSWORD
# 例：./gradlew :app:assembleRelease -Pchannel=play 读取 ANDROID_PLAY_*

ANDROID_COMMON_KEY_PATH=密钥文件路径（支持 ~ 与相对路径）
ANDROID_COMMON_STORE_PASSWORD=密钥库密码
ANDROID_COMMON_KEY_ALIAS=密钥别名
ANDROID_COMMON_KEY_PASSWORD=私钥密码
